ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# 服务首次启动时会把配置账号写入 SQLite 作为 admin。
# 普通用户在页面自助注册，注册后立即可登录使用。
# 多个初始 admin 可使用这个 JSON；设置后会替代上面的单个 admin。
# APP_ACCOUNTS_JSON=[{"username":"admin","password":"change-me"},{"username":"ops","password":"change-me-too"}]
SESSION_SECRET=change-me-to-a-long-random-string
SQLITE_PATH=data/app.sqlite
API_PORT=5174
AI_API_BASE_URL=https://done.amzdataincn.com/reseller/v1
AI_API_KEY=change-me
VITE_DEFAULT_API_URL=https://done.amzdataincn.com/reseller/v1
VITE_API_PROXY_AVAILABLE=true
VITE_API_PROXY_LOCKED=true
VITE_API_PROXY_SERVER_KEY_AVAILABLE=true
